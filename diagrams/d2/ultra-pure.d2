vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
    center: true
  }
}

direction: down

classes: {
  domain: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1976d2"
      stroke-width: 2
      border-radius: 4
    }
  }
  capability: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 2
    }
  }
  process: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 2
    }
  }
  critical: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 3
      bold: true
    }
  }
  earlyWin: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 3
    }
  }
  pinnacle: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      stroke-width: 3
      bold: true
    }
  }
  external: {
    style: {
      fill: "#f5f5f5"
      stroke: "#9e9e9e"
      stroke-width: 1
    }
  }
  legend: {
    style: {
      fill: "#fafafa"
      stroke: "#bdbdbd"
      stroke-width: 1
      font-size: 13
    }
  }
  material-edge: {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  tool-edge: {
    style: {
      stroke: "#666666"
      stroke-width: 1
      stroke-dash: 3
    }
  }
}

# ==================== INTERNAL NODES ====================
ultra-pure_internal: "Ultra-Pure Materials — Internal Structure" {
  ultra-pure_analytical-verification: PPT-Level Analytical Verification
  ultra-pure_high-purity-chemicals: High-Purity Chemical Purification
  ultra-pure_upw: Ultra-Pure Water Production
}

# ==================== DOMAIN NODE ====================
ultra-pure: Ultra-Pure Materials

# ==================== EXTERNAL DEPENDENCIES ====================
chemistry: Chemistry {
  shape: rectangle
}
measurement: "Measurement & Instrumentation" {
  shape: rectangle
}
photolithography_fab-processes_cmp: "Chemical Mechanical Planarization (CMP)" {
  shape: rectangle
}
silicon: Silicon {
  shape: rectangle
}
water: Water {
  shape: rectangle
}

# ==================== EDGES ====================
ultra-pure_analytical-verification -> ultra-pure_upw: { class: material-edge }
ultra-pure_high-purity-chemicals -> ultra-pure_upw: { class: material-edge }
photolithography_fab-processes_cmp -> ultra-pure_upw: { class: material-edge }
silicon -> ultra-pure: { class: material-edge }
ultra-pure_analytical-verification -> measurement: { class: tool-edge }
ultra-pure_high-purity-chemicals -> chemistry: { class: tool-edge }
ultra-pure_upw -> water: { class: material-edge }
ultra-pure -> chemistry: { class: tool-edge }

# ==================== STYLING ====================
ultra-pure.class: domain
ultra-pure_analytical-verification.class: capability
ultra-pure_high-purity-chemicals.class: capability
ultra-pure_upw.class: capability
chemistry.class: external
measurement.class: external
photolithography_fab-processes_cmp.class: external
silicon.class: external
water.class: external

# ==================== LEGEND ====================
d2-legend: "Edge Types" {
  class: legend
  mat: "Solid arrow = material prerequisite (physical input consumed)" {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  tool: "Dashed arrow = tool prerequisite (equipment/infrastructure needed)" {
    style: {
      stroke: "#666666"
      stroke-dash: 3
    }
  }
}
