vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
    center: true
  }
}

direction: down

classes: {
  domain: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1976d2"
      stroke-width: 2
      border-radius: 4
    }
  }
  capability: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 2
    }
  }
  process: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 2
    }
  }
  critical: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 3
      bold: true
    }
  }
  earlyWin: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 3
    }
  }
  pinnacle: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      stroke-width: 3
      bold: true
    }
  }
  external: {
    style: {
      fill: "#f5f5f5"
      stroke: "#9e9e9e"
      stroke-width: 1
    }
  }
  legend: {
    style: {
      fill: "#fafafa"
      stroke: "#bdbdbd"
      stroke-width: 1
      font-size: 13
    }
  }
  material-edge: {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  tool-edge: {
    style: {
      stroke: "#666666"
      stroke-width: 1
      stroke-dash: 3
    }
  }
}

# ==================== INTERNAL NODES ====================
energy_internal: "Energy — Internal Structure" {
  energy_biomass-energy: Biomass Energy
  energy_blue-energy: "Blue Energy (Osmotic Power)"
  energy_cooling: "Cooling Systems & Refrigeration"
  energy_electric-furnaces_electrode-manufacturing: Graphite Electrode Manufacturing
  energy_electric-furnaces: Electric Furnaces
  energy_electricity: "Electricity Generation & Distribution"
  energy_electricity_power-systems: Electric Power Systems for Semiconductor Fabrication
  energy_geothermal: Geothermal Energy
  energy_engine: Heat Engines
  energy_fuel-cell: Fuel Cell
  energy_fuels_charcoal: Charcoal Production
  energy_fuels_coal: "Coal Mining & Combustion"
  energy_fuels_coke: Coke Production
  energy_fuels: Fuel Production
  energy_furnace-design: Furnace Design Principles
  energy_gas-turbine: Gas Turbines
  energy_gravity: Water Power
  energy_gravity_water-turbines: Water Turbines
  energy_hvac: HVAC for General Industry
  energy_hydraulics: Hydraulic Power
  energy_internal-combustion: Internal Combustion Engines
  energy_photovoltaics: Photovoltaic Solar Power
  energy_pneumatics: Pneumatics
  energy_power-distribution: "Transformer & Power Distribution"
  energy_redox-flow-battery: Redox Flow Battery
  energy_refining: Fuel Refining
  energy_solar-thermal: Solar Thermal Energy
  energy_steam-power: Steam Power
  energy_steam-power_steam-turbines: Steam Turbines
  energy_stirling-engine: Stirling Engine
  energy_storage: "Energy Storage & Diversification"
