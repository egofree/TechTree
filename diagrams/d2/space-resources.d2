vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
    center: true
  }
}

direction: down

classes: {
  domain: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1976d2"
      stroke-width: 2
      border-radius: 4
    }
  }
  capability: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 2
    }
  }
  process: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 2
    }
  }
  critical: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 3
      bold: true
    }
  }
  earlyWin: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 3
    }
  }
  pinnacle: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      stroke-width: 3
      bold: true
    }
  }
  external: {
    style: {
      fill: "#f5f5f5"
      stroke: "#9e9e9e"
      stroke-width: 1
    }
  }
  legend: {
    style: {
      fill: "#fafafa"
      stroke: "#bdbdbd"
      stroke-width: 1
      font-size: 13
    }
  }
  material-edge: {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  tool-edge: {
    style: {
      stroke: "#666666"
      stroke-width: 1
      stroke-dash: 3
    }
  }
}

# ==================== INTERNAL NODES ====================
space-resources_internal: "Space Resources — Internal Structure" {
  space-resources_asteroid-mining_extraction-methods: Extraction Methods
  space-resources_asteroid-mining: Asteroid Mining
  space-resources_asteroid-mining_prospecting: Asteroid Prospecting
  space-resources_asteroid-mining_water-extraction-asteroid: Asteroid Water Extraction
  space-resources_lunar-isru: Lunar ISRU
  space-resources_lunar-isru_metal-extraction: Metal Extraction
  space-resources_lunar-isru_oxygen-extraction: Oxygen Extraction
  space-resources_lunar-isru_regolith-excavation: Regolith Excavation
  space-resources_lunar-isru_water-ice-mining: Water Ice Mining
  space-resources_mars-isru_atmosphere-collection: Atmosphere Collection
  space-resources_mars-isru: Mars ISRU
  space-resources_mars-isru_propellant-production-mars: "Propellant Production (Mars)"
  space-resources_mars-isru_sabatier-methanation: Sabatier Methanation
  space-resources_microgravity-manufacturing_additive-manufacturing: Additive Manufacturing
  space-resources_microgravity-manufacturing_crystal-growth: Crystal Growth
  space-resources_microgravity-manufacturing_fiber-pulling: ZBLAN Fiber Pulling
  space-resources_microgravity-manufacturing: Microgravity Manufacturing
  space-resources_space-recycling: "Space Recycling & Closed-Loop Logistics"
  space-resources_space-recycling_life-support-loop-closure: Life Support Loop Closure
  space-resources_space-recycling_material-reprocessing: Material Reprocessing
  space-resources_space-recycling_propellant-recycling: Propellant Recycling
}

# ==================== DOMAIN NODE ====================
space-resources: Space Resources

