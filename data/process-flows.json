        {"id": "s5", "label": "Melting (1500-1600°C tank furnace)", "type": "process"},
        {"id": "s6", "label": "Fining & Homogenization (remove bubbles)", "type": "process"},
        {"id": "s7", "label": "Forming (float bath / blowing / pressing)", "type": "process"},
        {"id": "s8", "label": "Annealing Lehr (stress relief, 500-550°C)", "type": "process"},
        {"id": "s9", "label": "Inspection: Defects Present?", "type": "decision"},
        {"id": "s10", "label": "Finished Glass Product", "type": "output"}
      ],
