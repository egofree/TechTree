vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
    center: true
  }
}

direction: down

classes: {
  processStep: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 2
    }
  }
  inputStep: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1976d2"
      stroke-width: 2
    }
  }
  outputStep: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 2
    }
  }
  decisionStep: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      stroke-width: 2
    }
  }
  flow-edge: {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  feedback-edge: {
    style: {
      stroke: "#666666"
      stroke-dash: 3
    }
  }
}

# Charcoal Production — Earth Kiln Method
s1: Hardwood Logs {
  shape: parallelogram
  class: inputStep
}
s2: Stack Wood in Pit / Kiln {
  shape: rectangle
  class: processStep
}
s3: Seal with Earth / Clay {
  shape: rectangle
  class: processStep
}
s4: "Ignite & Control Air Flow" {
  shape: rectangle
  class: processStep
}
s5: "Carbonization (300-600°C)" {
  shape: rectangle
  class: processStep
}
s6: Temperature Rising Too Fast? {
  shape: diamond
  class: decisionStep
}
s7: Adjust Ventilation {
  shape: rectangle
  class: processStep
}
s8: "Cool, Unseal & Sieve" {
  shape: rectangle
  class: processStep
}
s9: Charcoal Product {
  shape: parallelogram
  class: outputStep
}
s10: Wood Gas / Tar Byproducts {
  shape: parallelogram
  class: outputStep
}

# ==================== CONNECTIONS ====================
s1 -> s2: { class: flow-edge }
s2 -> s3: { class: flow-edge }
s3 -> s4: { class: flow-edge }
s4 -> s5: { class: flow-edge }
s5 -> s6: { class: flow-edge }
s6 -> s7: yes — smother { class: flow-edge }
s7 -> s5: { class: feedback-edge }
s6 -> s8: no — complete { class: flow-edge }
s8 -> s9: { class: flow-edge }
s5 -> s10: { class: flow-edge }
