    "silicon-wafer-preparation": {
      "title": "Silicon Wafer Preparation — Ingot to Prime Wafer",
      "domain": "silicon",
      "entity_id": "silicon.wafering",
      "description": "Conversion of single-crystal silicon ingots into polished prime wafers ready for device fabrication. The ingot is cropped, ground to diameter, sliced with wire saws into wafers, lapped, etched, and polished to mirror finish. Final cleaning removes particulates and metallic contamination. Wafer specifications: ±1μm thickness uniformity, <5Å surface roughness.",
