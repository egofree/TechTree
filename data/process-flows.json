    "silicon-czochralski-crystal-growth": {
      "title": "Czochralski Crystal Growth — Single-Crystal Silicon",
      "domain": "silicon",
      "entity_id": "silicon.crystal-growth.cz-pulling",
      "description": "Pulling single-crystal silicon ingots from molten polysilicon using a seed crystal in a quartz crucible at ~1415°C. Requires precision leadscrew for pull speed stability (±0.5%) and argon atmosphere. The Dash process eliminates dislocations via thin neck growth.",
      "steps": [
        {"id": "s1", "label": "Polysilicon Charge (9N+ purity)", "type": "input"},
        {"id": "s2", "label": "Argon Inert Atmosphere", "type": "input"},
        {"id": "s3", "label": "Melt Polysilicon in Quartz Crucible (1415°C)", "type": "process"},
        {"id": "s4", "label": "Dip Seed Crystal into Melt", "type": "process"},
        {"id": "s5", "label": "Dash Neck Growth (thin neck to eliminate dislocations)", "type": "process"},
        {"id": "s6", "label": "Shoulder Expansion & Body Pull", "type": "process"},
        {"id": "s7", "label": "Pull Speed Stable (±0.5%)?", "type": "decision"},
        {"id": "s8", "label": "Tail-Off & Cool", "type": "process"},
        {"id": "s9", "label": "Single-Crystal Silicon Ingot", "type": "output"}
      ],
      "connections": [
