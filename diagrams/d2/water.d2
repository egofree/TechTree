vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
    center: true
  }
}

direction: down

classes: {
  domain: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1976d2"
      stroke-width: 2
      border-radius: 4
    }
  }
  capability: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 2
    }
  }
  process: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 2
    }
  }
  critical: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 3
      bold: true
    }
  }
  earlyWin: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 3
    }
  }
  pinnacle: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      stroke-width: 3
      bold: true
    }
  }
  external: {
    style: {
      fill: "#f5f5f5"
      stroke: "#9e9e9e"
      stroke-width: 1
    }
  }
  legend: {
    style: {
      fill: "#fafafa"
      stroke: "#bdbdbd"
      stroke-width: 1
      font-size: 13
    }
  }
  material-edge: {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  tool-edge: {
    style: {
      stroke: "#666666"
      stroke-width: 1
      stroke-dash: 3
    }
  }
}

# ==================== INTERNAL NODES ====================
water_internal: "Water — Internal Structure" {
  water_basic-treatment: Basic Water Treatment
  water_desalination: Desalination
  water_distribution: Water Distribution
  water_procurement: Water Procurement
  water_sewage: "Sewage Collection & Treatment"
}

# ==================== DOMAIN NODE ====================
water: Water

# ==================== EXTERNAL DEPENDENCIES ====================
agriculture: Agriculture {
  shape: rectangle
}
agriculture_irrigation: Irrigation Systems {
  shape: rectangle
}
chemistry_bleaching: "Bleaching & Chlorine Chemistry" {
  shape: rectangle
}
chemistry_electrodialysis: Electrodialysis {
  shape: rectangle
}
chemistry_water-treatment: Industrial Water Treatment {
  shape: rectangle
}
ehs_waste-management: Waste Management {
  shape: rectangle
}
food-processing: Food Processing {
  shape: rectangle
}
foundations_tools-basic: "Stone & Wood Tools" {
  shape: rectangle
}
health_sanitation: "Water Supply & Sanitation" {
  shape: rectangle
}
metals_pipe-making: Pipe and Tube Manufacturing {
  shape: rectangle
}
ultra-pure_upw: Ultra-Pure Water Production {
  shape: rectangle
}

# ==================== EDGES ====================
agriculture_irrigation -> water_distribution: { class: material-edge }
agriculture -> water_procurement: { class: material-edge }
chemistry_electrodialysis -> water_desalination: { class: tool-edge }
chemistry_water-treatment -> water_sewage: { class: material-edge }
ehs_waste-management -> water_sewage: { class: tool-edge }
food-processing -> water: { class: material-edge }
health_sanitation -> water_procurement: { class: material-edge }
ultra-pure_upw -> water: { class: material-edge }
water_basic-treatment -> chemistry_bleaching: { class: material-edge }
water_distribution -> metals_pipe-making: { class: material-edge }
water_procurement -> foundations_tools-basic: { class: tool-edge }

# ==================== STYLING ====================
water.class: domain
water_basic-treatment.class: capability
water_desalination.class: capability
water_distribution.class: capability
water_procurement.class: capability
water_sewage.class: capability
agriculture.class: external
agriculture_irrigation.class: external
chemistry_bleaching.class: external
chemistry_electrodialysis.class: external
chemistry_water-treatment.class: external
ehs_waste-management.class: external
food-processing.class: external
foundations_tools-basic.class: external
health_sanitation.class: external
metals_pipe-making.class: external
ultra-pure_upw.class: external

# ==================== LEGEND ====================
d2-legend: "Edge Types" {
  class: legend
  mat: "Solid arrow = material prerequisite (physical input consumed)" {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  tool: "Dashed arrow = tool prerequisite (equipment/infrastructure needed)" {
    style: {
      stroke: "#666666"
      stroke-dash: 3
    }
  }
}
