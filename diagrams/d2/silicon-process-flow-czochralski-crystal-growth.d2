vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
    center: true
  }
}

direction: down

classes: {
  processStep: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 2
    }
  }
  inputStep: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1976d2"
      stroke-width: 2
    }
  }
  outputStep: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 2
    }
  }
  decisionStep: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      stroke-width: 2
    }
  }
  flow-edge: {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  feedback-edge: {
    style: {
      stroke: "#666666"
      stroke-dash: 3
    }
  }
}

# Czochralski Crystal Growth — Single-Crystal Silicon
s1: "Polysilicon Charge (9N+ purity)" {
  shape: parallelogram
  class: inputStep
}
s2: Argon Inert Atmosphere {
  shape: parallelogram
  class: inputStep
}
s3: "Melt Polysilicon in Quartz Crucible (1415°C)" {
  shape: rectangle
  class: processStep
}
s4: Dip Seed Crystal into Melt {
  shape: rectangle
  class: processStep
}
s5: "Dash Neck Growth (thin neck to eliminate dislocations)" {
  shape: rectangle
  class: processStep
}
s6: "Shoulder Expansion & Body Pull" {
  shape: rectangle
  class: processStep
}
s7: "Pull Speed Stable (±0.5%)?" {
  shape: diamond
  class: decisionStep
}
s8: "Tail-Off & Cool" {
  shape: rectangle
  class: processStep
}
s9: Single-Crystal Silicon Ingot {
  shape: parallelogram
  class: outputStep
}

# ==================== CONNECTIONS ====================
s1 -> s3: { class: flow-edge }
s2 -> s3: { class: flow-edge }
s3 -> s4: { class: flow-edge }
s4 -> s5: { class: flow-edge }
s5 -> s6: { class: flow-edge }
s6 -> s7: { class: flow-edge }
s7 -> s6: no — adjust speed { class: feedback-edge }
s7 -> s8: yes — target diameter reached { class: flow-edge }
s8 -> s9: { class: flow-edge }
