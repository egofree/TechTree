        {"id": "s4", "label": "Wire Saw Slicing (slurry or diamond wire)", "type": "process"},
        {"id": "s5", "label": "Wafer Thickness within Spec (±1μm)?", "type": "decision"},
        {"id": "s6", "label": "Lapping & Edge Rounding", "type": "process"},
        {"id": "s7", "label": "Chemical Etching (remove damaged layer)", "type": "process"},
        {"id": "s8", "label": "CMP Polishing to Mirror Finish (<5Å Ra)", "type": "process"},
        {"id": "s9", "label": "Final Clean (RCA-1 + RCA-2)", "type": "process"},
        {"id": "s10", "label": "Prime Silicon Wafer (epitaxy-ready)", "type": "output"}
