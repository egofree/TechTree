  human-spaceflight_crewed-spacecraft_launch-abort-systems: Launch Abort Systems
  human-spaceflight_crewed-spacecraft_reentry-systems: Reentry Systems
  human-spaceflight_eclss_atmosphere-management: Atmosphere Management
  human-spaceflight_eclss_fire-detection-suppression: "Fire Detection & Suppression"
  human-spaceflight_eclss: "Environmental Control & Life Support"
  human-spaceflight_eclss_thermal-humidity-control: "Thermal & Humidity Control"
  human-spaceflight_eclss_waste-management: Waste Management
  human-spaceflight_eclss_water-recovery: Water Recovery
  human-spaceflight_eva_eva-procedures: EVA Procedures + Protocols
  human-spaceflight_eva_eva-tools: EVA Tools + Restraints
  human-spaceflight_eva: "Extravehicular Activity (EVA)"
  human-spaceflight_radiation-protection_dosimetry-monitoring: "Dosimetry & Monitoring"
  human-spaceflight_radiation-protection: Radiation Protection
  human-spaceflight_radiation-protection_storm-shelters: Storm Shelters
  human-spaceflight_space-medicine_countermeasures: Countermeasures
  human-spaceflight_space-medicine_crew-selection: Crew Selection
  human-spaceflight_space-medicine_decompression-illness: Decompression Illness
  human-spaceflight_space-medicine: Space Medicine
  human-spaceflight_space-medicine_microgravity-physiology: Microgravity Physiology
  human-spaceflight_space-stations_habitat-modules: Habitat Module Fabrication
  human-spaceflight_space-stations: Space Stations
  human-spaceflight_space-stations_logistics-resupply: Logistics Resupply
  human-spaceflight_space-stations_robotic-arms: Robotic Manipulator Arms
  human-spaceflight_space-stations_structural-docking: Structural Docking + Berthing
  human-spaceflight_space-suits: Space Suits
  human-spaceflight_space-suits_plss-design: Portable Life Support System
  human-spaceflight_space-suits_pressure-garment: Pressure Garment Design
  human-spaceflight_space-suits_thermal-control-suit: Thermal Control Suit
}

# ==================== DOMAIN NODE ====================
human-spaceflight: Human Spaceflight

