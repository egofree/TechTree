vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
    center: true
  }
}

direction: down

classes: {
  processStep: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 2
    }
  }
  inputStep: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1976d2"
      stroke-width: 2
    }
  }
  outputStep: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 2
    }
  }
  decisionStep: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      stroke-width: 2
    }
  }
  flow-edge: {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  feedback-edge: {
    style: {
      stroke: "#666666"
      stroke-dash: 3
    }
  }
}

# Textile Manufacturing — Fiber to Finished Cloth
s1: "Raw Fibers (cotton/wool/flax)" {
  shape: parallelogram
  class: inputStep
}
s2: "Carding & Combing (align fibers)" {
  shape: rectangle
  class: processStep
}
s3: "Drawing & Roving (attenuate sliver)" {
  shape: rectangle
  class: processStep
}
s4: "Spinning (ring/frame → yarn)" {
  shape: rectangle
  class: processStep
}
s5: "Yarn Quality OK (tensile, evenness)?" {
  shape: diamond
  class: decisionStep
}
s6: "Warping & Sizing (prepare warp beam)" {
  shape: rectangle
  class: processStep
}
s7: "Weaving (interlace warp & weft on loom)" {
  shape: rectangle
  class: processStep
}
s8: "Finishing (washing, dyeing, calendering)" {
  shape: rectangle
  class: processStep
}
s9: Finished Woven Cloth {
  shape: parallelogram
  class: outputStep
}

# ==================== CONNECTIONS ====================
s1 -> s2: { class: flow-edge }
s2 -> s3: { class: flow-edge }
s3 -> s4: { class: flow-edge }
s4 -> s5: { class: flow-edge }
s5 -> s6: yes { class: flow-edge }
s5 -> s4: no — re-spin { class: feedback-edge }
s6 -> s7: { class: flow-edge }
s7 -> s8: { class: flow-edge }
s8 -> s9: { class: flow-edge }
