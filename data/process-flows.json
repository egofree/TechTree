  "flows": {
    "metals-iron-smelting": {
      "title": "Iron Smelting — Blast Furnace Process",
      "domain": "metals",
      "entity_id": "metals.iron-steel.blast-furnace",
      "description": "Continuous iron smelting in a tall shaft furnace producing liquid pig iron from iron ore, coke, and limestone. The blast furnace operates continuously for years, producing 10-1000+ tonnes of pig iron per day.",
      "steps": [
        {"id": "s1", "label": "Iron Ore (Fe₂O₃)", "type": "input"},
        {"id": "s2", "label": "Coke & Limestone Charging", "type": "input"},
        {"id": "s3", "label": "Hot Air Blast Injection (1200°C)", "type": "process"},
        {"id": "s4", "label": "Combustion Zone: C + O₂ → CO₂", "type": "process"},
        {"id": "s5", "label": "Reduction: Fe₂O₃ + 3CO → 2Fe + 3CO₂", "type": "process"},
        {"id": "s6", "label": "Slag Formation (CaO + SiO₂ → CaSiO₃)", "type": "process"},
        {"id": "s7", "label": "Temperature Adequate (>1200°C)?", "type": "decision"},
        {"id": "s8", "label": "Taphole Tapping", "type": "process"},
        {"id": "s9", "label": "Pig Iron (~4% C)", "type": "output"},
        {"id": "s10", "label": "Blast Furnace Slag", "type": "output"}
      ],
      "connections": [
        {"from": "s1", "to": "s3"},
        {"from": "s2", "to": "s3"},
        {"from": "s3", "to": "s4"},
        {"from": "s4", "to": "s5"},
        {"from": "s2", "to": "s6", "label": "flux"},
        {"from": "s5", "to": "s7"},
        {"from": "s7", "to": "s8", "label": "yes"},
        {"from": "s7", "to": "s3", "label": "no — increase blast"},
        {"from": "s8", "to": "s9"},
        {"from": "s8", "to": "s10"}
      ]
    },

    "chemistry-ammonia-production": {
      "title": "Ammonia Production — Haber-Bosch Process",
      "domain": "chemistry",
      "entity_id": "chemistry.ammonia",
      "description": "Catalytic synthesis of ammonia from nitrogen and hydrogen at 400-500°C and 15-30 MPa over an iron catalyst. The Haber-Bosch process feeds half the world's population through fertilizer production.",
      "steps": [
        {"id": "s1", "label": "Natural Gas / Methane Feed", "type": "input"},
        {"id": "s2", "label": "Air (N₂ Source)", "type": "input"},
        {"id": "s3", "label": "Steam Reforming: CH₄ + H₂O → CO + 3H₂", "type": "process"},
        {"id": "s4", "label": "Water-Gas Shift: CO + H₂O → CO₂ + H₂", "type": "process"},
        {"id": "s5", "label": "CO₂ Removal (amine scrubbing)", "type": "process"},
        {"id": "s6", "label": "H₂ Purity ≥ 99.9%?", "type": "decision"},
        {"id": "s7", "label": "Haber Synthesis: N₂ + 3H₂ → 2NH₃", "type": "process"},
        {"id": "s8", "label": "Condensation (−33°C)", "type": "process"},
        {"id": "s9", "label": "Liquid Ammonia (NH₃)", "type": "output"},
        {"id": "s10", "label": "Unreacted Gas Recycle", "type": "output"}
      ],
      "connections": [
