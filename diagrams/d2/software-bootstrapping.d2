vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
    center: true
  }
}

direction: down

classes: {
  domain: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1976d2"
      stroke-width: 2
      border-radius: 4
    }
  }
  capability: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 2
    }
  }
  process: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 2
    }
  }
  critical: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 3
      bold: true
    }
  }
  earlyWin: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 3
    }
  }
  pinnacle: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      stroke-width: 3
      bold: true
    }
  }
  external: {
    style: {
      fill: "#f5f5f5"
      stroke: "#9e9e9e"
      stroke-width: 1
    }
  }
  legend: {
    style: {
      fill: "#fafafa"
      stroke: "#bdbdbd"
      stroke-width: 1
      font-size: 13
    }
  }
  material-edge: {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  tool-edge: {
    style: {
      stroke: "#666666"
      stroke-width: 1
      stroke-dash: 3
    }
  }
}

# ==================== INTERNAL NODES ====================
software-bootstrapping_internal: "Software Bootstrapping — Internal Structure" {
  software-bootstrapping_assemblers: "Assemblers, Linkers & Loaders"
  software-bootstrapping_compilers: Compiler Construction
  software-bootstrapping_dev-tools: "Development Tools & Debugging"
  software-bootstrapping_machine-code: "Machine Code & Front-Panel Programming"
  software-bootstrapping_operating-systems: Operating System Construction
  software-bootstrapping_self-hosting: Self-Hosting Compiler Bootstrap
}

# ==================== DOMAIN NODE ====================
software-bootstrapping: Software Bootstrapping

# ==================== EXTERNAL DEPENDENCIES ====================
computing: "Computing & Automation" {
  shape: rectangle
}
knowledge_information-durability: Information Durability {
  shape: rectangle
}
vlsi-scaling_eda-design: "EDA, GPU Design & Advanced Packaging" {
  shape: rectangle
}

# ==================== EDGES ====================
software-bootstrapping_assemblers -> software-bootstrapping_machine-code: { class: tool-edge }
software-bootstrapping_compilers -> software-bootstrapping_assemblers: { class: tool-edge }
software-bootstrapping_dev-tools -> software-bootstrapping_compilers: { class: tool-edge }
software-bootstrapping_dev-tools -> software-bootstrapping_self-hosting: { class: tool-edge }
software-bootstrapping_operating-systems -> software-bootstrapping_dev-tools: { class: tool-edge }
software-bootstrapping_self-hosting -> software-bootstrapping_compilers: { class: tool-edge }
computing -> software-bootstrapping_operating-systems: { class: tool-edge }
software-bootstrapping -> computing: { class: tool-edge }
software-bootstrapping -> knowledge_information-durability: { class: tool-edge }
vlsi-scaling_eda-design -> software-bootstrapping: { class: tool-edge }

# ==================== STYLING ====================
software-bootstrapping.class: domain
software-bootstrapping_assemblers.class: critical
software-bootstrapping_compilers.class: critical
software-bootstrapping_dev-tools.class: capability
software-bootstrapping_machine-code.class: critical
software-bootstrapping_operating-systems.class: critical
software-bootstrapping_self-hosting.class: critical
computing.class: external
knowledge_information-durability.class: external
vlsi-scaling_eda-design.class: external

# ==================== LEGEND ====================
d2-legend: "Edge Types" {
  class: legend
  mat: "Solid arrow = material prerequisite (physical input consumed)" {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  tool: "Dashed arrow = tool prerequisite (equipment/infrastructure needed)" {
    style: {
      stroke: "#666666"
      stroke-dash: 3
    }
  }
}
