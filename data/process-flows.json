        {"from": "s6", "to": "s7"},
        {"from": "s7", "to": "s8", "label": "yes"},
        {"from": "s7", "to": "s4", "label": "no — re-blow"},
        {"from": "s8", "to": "s9"},
        {"from": "s9", "to": "s10"}
      ]
    },

    "chemistry-sulfuric-acid": {
      "title": "Sulfuric Acid — Contact Process",
      "domain": "chemistry",
      "entity_id": "chemistry.acids.contact-process",
      "description": "Industrial production of sulfuric acid via the contact process. Elemental sulfur or metal sulfide ore is burned to SO₂, catalytically oxidized to SO₃ over vanadium pentoxide at 400-450°C, then absorbed in concentrated H₂SO₄ to form oleum, which is diluted to yield 98% H₂SO₄. The most-produced chemical by tonnage worldwide.",
      "steps": [
        {"id": "s1", "label": "Elemental Sulfur / Sulfide Ore", "type": "input"},
        {"id": "s2", "label": "Combustion: S + O₂ → SO₂ (1000°C)", "type": "process"},
        {"id": "s3", "label": "Gas Cooling & Purification (ESP + scrubbing)", "type": "process"},
        {"id": "s4", "label": "Catalytic Oxidation: 2SO₂ + O₂ → 2SO₃ (V₂O₅, 450°C)", "type": "process"},
        {"id": "s5", "label": "Conversion Efficiency ≥ 99%?", "type": "decision"},
        {"id": "s6", "label": "Double-Absorption Pass (re-oxidize tail gas)", "type": "process"},
        {"id": "s7", "label": "SO₃ Absorption in 98% H₂SO₄ → Oleum", "type": "process"},
        {"id": "s8", "label": "Dilution: H₂S₂O₇ + H₂O → 2H₂SO₄", "type": "process"},
        {"id": "s9", "label": "98% Sulfuric Acid Product", "type": "output"}
      ],
      "connections": [
        {"from": "s1", "to": "s2"},
        {"from": "s2", "to": "s3"},
        {"from": "s3", "to": "s4"},
        {"from": "s4", "to": "s5"},
        {"from": "s5", "to": "s6", "label": "no — insufficient"},
        {"from": "s6", "to": "s4"},
        {"from": "s5", "to": "s7", "label": "yes"},
        {"from": "s7", "to": "s8"},
        {"from": "s8", "to": "s9"}
      ]
    },

    "chemistry-electrolysis-chlor-alkali": {
      "title": "Chlor-Alkali Process — Membrane Cell Electrolysis",
      "domain": "chemistry",
      "entity_id": "chemistry.electrolysis.chlor-alkali",
      "description": "Electrolysis of saturated brine (NaCl solution) in membrane cells to produce chlorine gas, sodium hydroxide (caustic soda), and hydrogen. Modern plants use perfluorinated ion-exchange membranes (Nafion). Chlor-alkali is the foundation of the chlor-chemical industry, producing PVC, solvents, and bleaching agents.",
      "steps": [
