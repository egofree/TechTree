vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
    center: true
  }
}

direction: down

classes: {
  domain: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1976d2"
      stroke-width: 2
      border-radius: 4
    }
  }
  capability: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 2
    }
  }
  process: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 2
    }
  }
  critical: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 3
      bold: true
    }
  }
  earlyWin: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 3
    }
  }
  pinnacle: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      stroke-width: 3
      bold: true
    }
  }
  external: {
    style: {
      fill: "#f5f5f5"
      stroke: "#9e9e9e"
      stroke-width: 1
    }
  }
  legend: {
    style: {
      fill: "#fafafa"
      stroke: "#bdbdbd"
      stroke-width: 1
      font-size: 13
    }
  }
  material-edge: {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  tool-edge: {
    style: {
      stroke: "#666666"
      stroke-width: 1
      stroke-dash: 3
    }
  }
}

# ==================== INTERNAL NODES ====================
machine-tools_internal: "Machine Tools Bootstrap — Internal Structure" {
  machine-tools_abrasives: "Abrasives & Cutting Tools"
  machine-tools_bearings-abrasives: "Bearings, Abrasives & Cutting Tools"
  machine-tools_bearings: Bearings
  machine-tools_edm-cnc: "EDM, CNC & Precision Grinding"
  machine-tools_fasteners: "Screw Cutting & Fastener Standardization"
  machine-tools_forming: Metal Forming
  machine-tools_gears: "Gears & Gear Manufacturing"
  machine-tools_hydraulic-systems: Hydraulic Systems for Machine Tools
  machine-tools_iterative-bootstrap: Iterative Machine Bootstrap
  machine-tools_joining_brazing-soldering: "Brazing & Soldering"
  machine-tools_joining_diffusion-bonding: Diffusion Bonding
  machine-tools_joining_electron-beam: Electron Beam Welding
  machine-tools_joining_friction-stir: Friction Stir Welding
  machine-tools_joining: Metal Joining
  machine-tools_joining_laser-welding: Laser Welding
  machine-tools_joining_mig-welding: "MIG Welding (GMAW)"
  machine-tools_joining_resistance-welding: "Resistance Welding (Spot & Seam)"
  machine-tools_joining_riveting: Riveting
  machine-tools_joining_tig-welding: "TIG Welding (GTAW)"
  machine-tools_joining_ultrasonic-bonding: "Ultrasonic Welding & Wire Bonding"
  machine-tools_joining_welding: Welding Processes
  machine-tools_machining: Machining
  machine-tools_mass-production: "Mass Production & Interchangeability"
  machine-tools_power-transmission: "Belt & Shaft Power Transmission"
}

# ==================== DOMAIN NODE ====================
machine-tools: Machine Tools Bootstrap

