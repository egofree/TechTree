vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
    center: true
  }
}

direction: down

classes: {
  domain: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1976d2"
      stroke-width: 2
      border-radius: 4
    }
  }
  capability: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 2
    }
  }
  process: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 2
    }
  }
  critical: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 3
      bold: true
    }
  }
  earlyWin: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 3
    }
  }
  pinnacle: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      stroke-width: 3
      bold: true
    }
  }
  external: {
    style: {
      fill: "#f5f5f5"
      stroke: "#9e9e9e"
      stroke-width: 1
    }
  }
  legend: {
    style: {
      fill: "#fafafa"
      stroke: "#bdbdbd"
      stroke-width: 1
      font-size: 13
    }
  }
  material-edge: {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  tool-edge: {
    style: {
      stroke: "#666666"
      stroke-width: 1
      stroke-dash: 3
    }
  }
}

# ==================== INTERNAL NODES ====================
space-ground-ops_internal: "Space Ground Operations — Internal Structure" {
  space-ground-ops_ground-stations_antenna-systems: Antenna Systems
  space-ground-ops_ground-stations: Ground Stations
  space-ground-ops_ground-stations_network-distribution: Network Distribution
  space-ground-ops_ground-stations_rf-front-ends: RF Front-Ends
  space-ground-ops_launch-complex_gantry-tower: "Gantry & Service Tower"
  space-ground-ops_launch-complex: Launch Complex
  space-ground-ops_launch-complex_lightning-protection: Lightning Protection Systems
  space-ground-ops_launch-complex_pad-structure: "Pad Structure & Flame Trench"
  space-ground-ops_launch-complex_propellant-facilities: Propellant Storage Facilities
  space-ground-ops_mission-control: Mission Control
  space-ground-ops_mission-control_mcc-facilities: MCC Facilities
  space-ground-ops_mission-control_telemetry-processing: Telemetry Processing
  space-ground-ops_range-safety_flight-termination: Flight Termination
  space-ground-ops_range-safety: Range Safety
  space-ground-ops_range-safety_optical-tracking: Optical Tracking
  space-ground-ops_range-safety_range-radar: Range Radar
  space-ground-ops_vehicle-assembly: Vehicle Assembly
  space-ground-ops_vehicle-assembly_transporter-erector: "Transporter/Erector & Crawler"
  space-ground-ops_vehicle-assembly_vab-facilities: Vertical Assembly Building
}

# ==================== DOMAIN NODE ====================
space-ground-ops: Space Ground Operations

# ==================== EXTERNAL DEPENDENCIES ====================
computing: "Computing & Automation" {
  shape: rectangle
}
construction: "Construction & Structural Engineering" {
  shape: rectangle
}
cryogenics_liquefaction-storage: "Gas Liquefaction & Storage" {
  shape: rectangle
}
