vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
    center: true
  }
}

direction: down

classes: {
  domain: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1976d2"
      stroke-width: 2
      border-radius: 4
    }
  }
  capability: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 2
    }
  }
  process: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 2
    }
  }
  critical: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 3
      bold: true
    }
  }
  earlyWin: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 3
    }
  }
  pinnacle: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      stroke-width: 3
      bold: true
    }
  }
  external: {
    style: {
      fill: "#f5f5f5"
      stroke: "#9e9e9e"
      stroke-width: 1
    }
  }
  legend: {
    style: {
      fill: "#fafafa"
      stroke: "#bdbdbd"
      stroke-width: 1
      font-size: 13
    }
  }
  material-edge: {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  tool-edge: {
    style: {
      stroke: "#666666"
      stroke-width: 1
      stroke-dash: 3
    }
  }
}

# ==================== INTERNAL NODES ====================
precision-motion_internal: "Precision Motion Control — Internal Structure" {
  precision-motion_nanometer-positioning: Nanometer Positioning
  precision-motion_precision-encoders: "Precision Encoders & Feedback"
  precision-motion_vibration-isolation: Vibration Isolation
  precision-motion_wafer-stages: "Wafer Stages & Scanner Systems"
}

# ==================== DOMAIN NODE ====================
precision-motion: Precision Motion Control

# ==================== EXTERNAL DEPENDENCIES ====================
construction: "Construction & Structural Engineering" {
  shape: rectangle
}
energy_electricity: "Electricity Generation & Distribution" {
  shape: rectangle
}
gas-handling: Gas Handling {
  shape: rectangle
}
machine-tools: Machine Tools Bootstrap {
  shape: rectangle
}
machine-tools_edm-cnc: "EDM, CNC & Precision Grinding" {
  shape: rectangle
}
measurement: "Measurement & Instrumentation" {
  shape: rectangle
}
measurement_precision-metrology: "Precision Metrology & Standards" {
  shape: rectangle
}
optics: Optics {
  shape: rectangle
}
photolithography_fab-processes_cmp: "Chemical Mechanical Planarization (CMP)" {
  shape: rectangle
}
vacuum_deposition-systems: Deposition Systems {
  shape: rectangle
}

# ==================== EDGES ====================
photolithography_fab-processes_cmp -> precision-motion_nanometer-positioning: { class: tool-edge }
precision-motion_nanometer-positioning -> energy_electricity: { class: tool-edge }
precision-motion_nanometer-positioning -> machine-tools_edm-cnc: { class: tool-edge }
precision-motion_nanometer-positioning -> measurement_precision-metrology: { class: tool-edge }
precision-motion_precision-encoders -> measurement_precision-metrology: { class: tool-edge }
precision-motion_precision-encoders -> optics: { class: tool-edge }
precision-motion_vibration-isolation -> construction: { class: tool-edge }
precision-motion_vibration-isolation -> gas-handling: { class: tool-edge }
precision-motion_wafer-stages -> machine-tools_edm-cnc: { class: tool-edge }
precision-motion -> machine-tools: { class: tool-edge }
precision-motion -> measurement: { class: tool-edge }
vacuum_deposition-systems -> precision-motion: { class: tool-edge }

# ==================== STYLING ====================
precision-motion.class: domain
precision-motion_nanometer-positioning.class: capability
precision-motion_precision-encoders.class: capability
precision-motion_vibration-isolation.class: capability
precision-motion_wafer-stages.class: pinnacle
construction.class: external
energy_electricity.class: external
gas-handling.class: external
machine-tools.class: external
machine-tools_edm-cnc.class: external
measurement.class: external
measurement_precision-metrology.class: external
optics.class: external
photolithography_fab-processes_cmp.class: external
vacuum_deposition-systems.class: external

# ==================== LEGEND ====================
d2-legend: "Edge Types" {
  class: legend
  mat: "Solid arrow = material prerequisite (physical input consumed)" {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  tool: "Dashed arrow = tool prerequisite (equipment/infrastructure needed)" {
    style: {
      stroke: "#666666"
      stroke-dash: 3
    }
  }
}
