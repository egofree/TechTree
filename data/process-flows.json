        {"id": "s2", "label": "HMDS Priming (adhesion promotion)", "type": "process"},
        {"id": "s3", "label": "Photoresist Spin Coating (1-5μm)", "type": "process"},
        {"id": "s4", "label": "Soft Bake (drive off solvent)", "type": "process"},
        {"id": "s5", "label": "UV Exposure through Photomask (193i/EUV)", "type": "process"},
        {"id": "s6", "label": "Post-Exposure Bake (PEB)", "type": "process"},
        {"id": "s7", "label": "Development (TMAH developer)", "type": "process"},
        {"id": "s8", "label": "Pattern Transfer OK (CD within spec)?", "type": "decision"},
        {"id": "s9", "label": "Etch Pattern Transfer (RIE/plasma)", "type": "process"},
        {"id": "s10", "label": "Resist Strip & Clean (O₂ plasma + wet)", "type": "output"}
      ],
