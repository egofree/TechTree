    classDef decisionStep fill:#fce4ec,stroke:#c62828,stroke-width:2px
    class s1 inputStep
    class s2 processStep
    class s3 processStep
    class s4 processStep
    class s5 processStep
    class s6 processStep
    class s7 processStep
