vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
    center: true
  }
}

direction: down

classes: {
  processStep: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 2
    }
  }
  inputStep: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1976d2"
      stroke-width: 2
    }
  }
  outputStep: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 2
    }
  }
  decisionStep: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      stroke-width: 2
    }
  }
  flow-edge: {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  feedback-edge: {
    style: {
      stroke: "#666666"
      stroke-dash: 3
    }
  }
}

# Steelmaking — Basic Oxygen Furnace Route
s1: "Molten Pig Iron (~4% C, 1350°C)" {
  shape: parallelogram
  class: inputStep
}
s2: "Scrap Steel Charge (25-30%)" {
  shape: parallelogram
  class: inputStep
}
s3: "Lime & Flux Additions" {
  shape: parallelogram
  class: inputStep
}
s4: "Oxygen Blow (supersonic lance, 15-20 min)" {
  shape: rectangle
  class: processStep
}
s5: "Decarburization: C + O₂ → CO/CO₂" {
  shape: rectangle
  class: processStep
}
s6: "Slag Formation (P, Si, Mn oxidation)" {
  shape: rectangle
  class: processStep
}
s7: "Carbon Target Reached (<0.05% C)?" {
  shape: diamond
  class: decisionStep
}
s8: "Alloy Addition & Ladle Metallurgy" {
  shape: rectangle
  class: processStep
}
s9: Continuous Casting → Slabs/Billets {
  shape: rectangle
  class: processStep
}
s10: Hot-Rolled Steel Products {
  shape: parallelogram
  class: outputStep
}

# ==================== CONNECTIONS ====================
s1 -> s4: { class: flow-edge }
s2 -> s4: { class: flow-edge }
s3 -> s4: { class: flow-edge }
s4 -> s5: { class: flow-edge }
s5 -> s6: { class: flow-edge }
s6 -> s7: { class: flow-edge }
s7 -> s8: yes { class: flow-edge }
s7 -> s4: no — re-blow { class: feedback-edge }
s8 -> s9: { class: flow-edge }
s9 -> s10: { class: flow-edge }
