        {"id": "s2", "label": "Carding & Combing (align fibers)", "type": "process"},
        {"id": "s3", "label": "Drawing & Roving (attenuate sliver)", "type": "process"},
        {"id": "s4", "label": "Spinning (ring/frame → yarn)", "type": "process"},
