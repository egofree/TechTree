    "photolithography-photolithography": {
      "title": "Photolithography — Patterning Process",
      "domain": "photolithography",
      "entity_id": "photolithography.photolithography",
      "description": "The core pattern transfer process in semiconductor fabrication. A photosensitive resist is applied to the wafer, exposed through a photomask (or via direct write), developed to reveal the pattern, and then the underlying film is etched. Resist stripping completes the cycle. Repeated 20-80 times per chip with alignment precision measured in nanometers.",
