        {"id": "s2", "label": "Demineralized Water", "type": "input"},
        {"id": "s3", "label": "Brine Purification (ion exchange, SS removal)", "type": "process"},
        {"id": "s4", "label": "Electrolysis: 2NaCl + 2H₂O → Cl₂ + 2NaOH + H₂", "type": "process"},
        {"id": "s5", "label": "Membrane Integrity OK?", "type": "decision"},
        {"id": "s6", "label": "Chlorine Gas (Cl₂) Collection & Liquefaction", "type": "process"},
        {"id": "s7", "label": "Caustic Soda (50% NaOH) Concentration", "type": "process"},
        {"id": "s8", "label": "H₂ Recovery & Compression", "type": "process"},
        {"id": "s9", "label": "Cl₂ Product (dry, liquid)", "type": "output"},
        {"id": "s10", "label": "50% NaOH + H₂ Products", "type": "output"}
      ],
      "connections": [
