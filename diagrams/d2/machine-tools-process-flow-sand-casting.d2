vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
    center: true
  }
}

direction: down

classes: {
  processStep: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 2
    }
  }
  inputStep: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1976d2"
      stroke-width: 2
    }
  }
  outputStep: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 2
    }
  }
  decisionStep: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      stroke-width: 2
    }
  }
  flow-edge: {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  feedback-edge: {
    style: {
      stroke: "#666666"
      stroke-dash: 3
    }
  }
}

# Sand Casting — Metal Part Production
s1: "Pattern (wood/metal, with shrinkage allowance)" {
  shape: parallelogram
  class: inputStep
}
s2: "Green Sand (silica + bentonite + water)" {
  shape: parallelogram
  class: inputStep
}
s3: Pack Sand Around Pattern in Flask {
  shape: rectangle
  class: processStep
}
s4: Remove Pattern → Form Cavity {
  shape: rectangle
  class: processStep
}
s5: "Core Placement (for internal cavities)" {
  shape: rectangle
  class: processStep
}
s6: "Molten Metal Pour (Fe: 1400°C, Al: 700°C)" {
  shape: rectangle
  class: processStep
}
s7: "Solidification & Cooling" {
  shape: rectangle
  class: processStep
}
s8: "Defects Present (porosity/shrinkage)?" {
  shape: diamond
  class: decisionStep
}
s9: "Shakeout, Trim & Clean" {
  shape: rectangle
  class: processStep
}
s10: Cast Metal Part {
  shape: parallelogram
  class: outputStep
}

# ==================== CONNECTIONS ====================
s1 -> s3: { class: flow-edge }
s2 -> s3: { class: flow-edge }
s3 -> s4: { class: flow-edge }
s4 -> s5: { class: flow-edge }
s5 -> s6: { class: flow-edge }
s6 -> s7: { class: flow-edge }
s7 -> s8: { class: flow-edge }
s8 -> s9: acceptable { class: flow-edge }
s8 -> s3: reject — remold { class: feedback-edge }
s9 -> s10: { class: flow-edge }
