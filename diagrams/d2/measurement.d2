vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
    center: true
  }
}

direction: down

classes: {
  domain: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1976d2"
      stroke-width: 2
      border-radius: 4
    }
  }
  capability: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 2
    }
  }
  process: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 2
    }
  }
  critical: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 3
      bold: true
    }
  }
  earlyWin: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 3
    }
  }
  pinnacle: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      stroke-width: 3
      bold: true
    }
  }
  external: {
    style: {
      fill: "#f5f5f5"
      stroke: "#9e9e9e"
      stroke-width: 1
    }
  }
  legend: {
    style: {
      fill: "#fafafa"
      stroke: "#bdbdbd"
      stroke-width: 1
      font-size: 13
    }
  }
  material-edge: {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  tool-edge: {
    style: {
      stroke: "#666666"
      stroke-width: 1
      stroke-dash: 3
    }
  }
}

# ==================== INTERNAL NODES ====================
measurement_internal: "Measurement & Instrumentation — Internal Structure" {
  measurement_electrical-instruments: Electrical Measurement Instruments
  measurement_horology: "Clockmaking & Precision Horology"
  measurement_optical-instruments: Optical Measurement Instruments
  measurement_precision-metrology: "Precision Metrology & Standards"
  measurement_temperature-pressure: "Temperature & Pressure Measurement"
  measurement_thermostat-advanced: "Advanced & Specialty Thermostats"
  measurement_thermostat-electrical: Electrical Thermostats
  measurement_thermostat-electronic: Electronic Thermostats
  measurement_thermostat-fluid: "Fluid & Gas Thermostats"
  measurement_thermostat-mechanical: Mechanical Thermostats
}

# ==================== DOMAIN NODE ====================
measurement: "Measurement & Instrumentation"

