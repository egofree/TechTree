vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
    center: true
  }
}

direction: down

classes: {
  domain: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1976d2"
      stroke-width: 2
      border-radius: 4
    }
  }
  capability: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 2
    }
  }
  process: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 2
    }
  }
  critical: {
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
      stroke-width: 3
      bold: true
    }
  }
  earlyWin: {
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
      stroke-width: 3
    }
  }
  pinnacle: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      stroke-width: 3
      bold: true
    }
  }
  external: {
    style: {
      fill: "#f5f5f5"
      stroke: "#9e9e9e"
      stroke-width: 1
    }
  }
  legend: {
    style: {
      fill: "#fafafa"
      stroke: "#bdbdbd"
      stroke-width: 1
      font-size: 13
    }
  }
  material-edge: {
    style: {
      stroke: "#333333"
      stroke-width: 2
    }
  }
  tool-edge: {
    style: {
      stroke: "#666666"
      stroke-width: 1
      stroke-dash: 3
    }
  }
}

# ==================== INTERNAL NODES ====================
launch-vehicles_internal: "Launch Vehicles — Internal Structure" {
  launch-vehicles_edl_heat-shield-design: Heat Shield Design
  launch-vehicles_edl: "Entry, Descent & Landing"
  launch-vehicles_edl_parachute-systems: Parachute Systems
  launch-vehicles_edl_precision-landing: Precision Landing
  launch-vehicles_edl_retropropulsion: Retropropulsion
  launch-vehicles_hybrid-propulsion_fuel-grain-design: Fuel Grain Design
  launch-vehicles_hybrid-propulsion: Hybrid Propulsion
  launch-vehicles_hybrid-propulsion_oxidizer-feed-systems: Oxidizer Feed Systems
  launch-vehicles_liquid-propulsion_combustion-chamber: Combustion Chamber
  launch-vehicles_liquid-propulsion_engine-cycles: Engine Cycles
  launch-vehicles_liquid-propulsion_ignition-systems: Ignition Systems
  launch-vehicles_liquid-propulsion_injector-design: Injector Design
  launch-vehicles_liquid-propulsion: Liquid Propulsion
  launch-vehicles_liquid-propulsion_nozzle-design: Nozzle Design
  launch-vehicles_liquid-propulsion_turbopump-design: Turbopump Design
  launch-vehicles_propellant-production_hypergolic-synthesis: Hypergolic Synthesis
  launch-vehicles_propellant-production: Propellant Production
  launch-vehicles_propellant-production_lh2-production: LH2 Production
  launch-vehicles_propellant-production_lox-production: LOX Production
  launch-vehicles_propellant-production_rp1-refining: RP-1 Refining
  launch-vehicles_propellant-production_solid-propellant-mixing: Solid Propellant Mixing
  launch-vehicles_solid-propulsion_case-bonding: Case Bonding
  launch-vehicles_solid-propulsion_grain-design: Grain Design
  launch-vehicles_solid-propulsion: Solid Propulsion
  launch-vehicles_solid-propulsion_nozzle-ablation: Nozzle Ablation
  launch-vehicles_solid-propulsion_propellant-casting: Propellant Casting
  launch-vehicles_vehicle-architecture_gvnc-integration: GNC Integration
  launch-vehicles_vehicle-architecture: Vehicle Architecture
  launch-vehicles_vehicle-architecture_payload-fairing: Payload Fairing
  launch-vehicles_vehicle-architecture_staging-design: Staging Design
  launch-vehicles_vehicle-architecture_structural-design: Structural Design
}

