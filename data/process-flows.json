        {"id": "s8", "label": "Defects Present (porosity/shrinkage)?", "type": "decision"},
        {"id": "s9", "label": "Shakeout, Trim & Clean", "type": "process"},
        {"id": "s10", "label": "Cast Metal Part", "type": "output"}
      ],
