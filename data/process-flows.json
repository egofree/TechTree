    "metals-steel-making": {
      "title": "Steelmaking — Basic Oxygen Furnace Route",
      "domain": "metals",
      "entity_id": "metals.steelmaking",
      "description": "Conversion of pig iron to steel via basic oxygen furnace (BOF). Molten pig iron is charged into the BOF vessel, oxygen is blown at supersonic speed to oxidize carbon, silicon, and phosphorus. Alloy additions tailor the grade. Continuous casting solidifies the steel into slabs or billets for rolling.",
      "steps": [
        {"id": "s1", "label": "Molten Pig Iron (~4% C, 1350°C)", "type": "input"},
        {"id": "s2", "label": "Scrap Steel Charge (25-30%)", "type": "input"},
        {"id": "s3", "label": "Lime & Flux Additions", "type": "input"},
        {"id": "s4", "label": "Oxygen Blow (supersonic lance, 15-20 min)", "type": "process"},
        {"id": "s5", "label": "Decarburization: C + O₂ → CO/CO₂", "type": "process"},
        {"id": "s6", "label": "Slag Formation (P, Si, Mn oxidation)", "type": "process"},
        {"id": "s7", "label": "Carbon Target Reached (<0.05% C)?", "type": "decision"},
        {"id": "s8", "label": "Alloy Addition & Ladle Metallurgy", "type": "process"},
        {"id": "s9", "label": "Continuous Casting → Slabs/Billets", "type": "process"},
        {"id": "s10", "label": "Hot-Rolled Steel Products", "type": "output"}
      ],
      "connections": [
        {"from": "s1", "to": "s4"},
        {"from": "s2", "to": "s4"},
        {"from": "s3", "to": "s4"},
        {"from": "s4", "to": "s5"},
