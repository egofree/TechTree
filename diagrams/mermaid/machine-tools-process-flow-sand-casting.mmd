    s5["Core Placement (for internal cavities)"]
    s6["Molten Metal Pour (Fe: 1400°C, Al: 700°C)"]
    s7["Solidification & Cooling"]
    s8{"Defects Present (porosity/shrinkage)?"}
    s9["Shakeout, Trim & Clean"]
