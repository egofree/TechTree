  shape: rectangle
}
electronics: Electronics {
  shape: rectangle
}
foundations: Foundations {
  shape: rectangle
}
gas-handling: Gas Handling {
  shape: rectangle
}
machine-tools: Machine Tools Bootstrap {
  shape: rectangle
}
metals: Metals {
  shape: rectangle
}
optics: Optics {
  shape: rectangle
}
telecom_radio: Radio Communication {
  shape: rectangle
}
water: Water {
  shape: rectangle
}

